	"entrypoints": {
		"main": [
			"com.izofar.bygonefortress.BygoneFortressMod"
		]
	},
	"mixins": [
		"bygonefortress.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "1.20.1",
		"java": ">=17",
		"fabric-api": "*"
